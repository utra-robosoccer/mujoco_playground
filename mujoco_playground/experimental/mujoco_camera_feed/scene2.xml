<mujoco model="robosoccer">
  <compiler angle="degree" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="RK4"/>

  <asset>
    <texture name="grass_tex" type="2d" file="assets/grass.png"/>
    <material name="grass_mat" texture="grass_tex" texrepeat="50 35" rgba="1 1 1 1" emission="0.15"/>
    <material name="line_white" rgba="1 1 1 1"/>
    <material name="ball_mat" rgba="1 1 1 1" specular="0.2" shininess="0.1"/>
  </asset>

  <worldbody>
    <camera name="field_cam" pos="0 -30 40" quat="0.7 0 0 0.7"/>
    <light name="top" pos="0 0 30"/>

<!-- 1) Hard collision ground (invisible) -->
<geom name="ground_collision" type="plane" pos="0 0 0" size="15 10 1"
      rgba="1 1 1 0"
      condim="3"
      friction="1.0 0.002 0.004"
      priority="2"
      solref="0.01 1.5"
      solimp="0.9 0.95 0.001"/>

<!-- 2) Visual grass decal (no collisions), lifted to avoid z-fighting -->
<geom name="field_visual" type="plane" pos="0 0 0.004" size="15 10 1"
      material="grass_mat"
      contype="0" conaffinity="0"
      priority="1"/>



    <!-- ================= FIELD LINES (non-colliding) ================= -->
    <body name="lines" pos="0 0 0">
      <geom name="touch_top"    type="box" pos="0   9.96 0.01" size="15   0.04 0.002" material="line_white" contype="0" conaffinity="0"/>
      <geom name="touch_bottom" type="box" pos="0  -9.96 0.01" size="15   0.04 0.002" material="line_white" contype="0" conaffinity="0"/>
      <geom name="goal_left"    type="box" pos="-14.96 0   0.01" size="0.04 10   0.002" material="line_white" contype="0" conaffinity="0"/>
      <geom name="goal_right"   type="box" pos=" 14.96 0   0.01" size="0.04 10   0.002" material="line_white" contype="0" conaffinity="0"/>
      <geom name="halfway" type="box" pos="0 0 0.01" size="0.04 10 0.002" material="line_white" contype="0" conaffinity="0"/>

      <!-- Center circle hollow ring -->
      <geom name="center_outer" type="cylinder" pos="0 0 0.0105" size="2.6 0.0005" material="line_white" contype="0" conaffinity="0"/>
      <geom name="center_inner_grass" type="cylinder" pos="0 0 0.0112" size="2.45 0.0007" material="grass_mat" contype="0" conaffinity="0"/>
      <geom name="center_spot" type="cylinder" pos="0 0 0.0118" size="0.1 0.0007" material="line_white" contype="0" conaffinity="0"/>

      <geom name="pen_spot_L" type="cylinder" pos="-12 0 0.011" axisangle="1 0 0 0" size="0.1 0.001" material="line_white" contype="0" conaffinity="0"/>
      <geom name="pen_spot_R" type="cylinder" pos=" 12 0 0.011" axisangle="1 0 0 0" size="0.1 0.001" material="line_white" contype="0" conaffinity="0"/>

      <!-- Penalty areas -->
      <geom type="box" pos="-12.5  6.0 0.01" size="2.5 0.04 0.002" material="line_white" contype="0" conaffinity="0"/>
      <geom type="box" pos="-12.5 -6.0 0.01" size="2.5 0.04 0.002" material="line_white" contype="0" conaffinity="0"/>
      <geom type="box" pos="-10.0  0.0 0.01" size="0.04 6.0 0.002" material="line_white" contype="0" conaffinity="0"/>
      <geom type="box" pos=" 12.5  6.0 0.01" size="2.5 0.04 0.002" material="line_white" contype="0" conaffinity="0"/>
      <geom type="box" pos=" 12.5 -6.0 0.01" size="2.5 0.04 0.002" material="line_white" contype="0" conaffinity="0"/>
      <geom type="box" pos=" 10.0  0.0 0.01" size="0.04 6.0 0.002" material="line_white" contype="0" conaffinity="0"/>

      <!-- Goal boxes -->
      <geom type="box" pos="-14.1  3.0 0.01" size="0.9 0.04 0.002" material="line_white" contype="0" conaffinity="0"/>
      <geom type="box" pos="-14.1 -3.0 0.01" size="0.9 0.04 0.002" material="line_white" contype="0" conaffinity="0"/>
      <geom type="box" pos="-13.2  0.0 0.01" size="0.04 3.0 0.002" material="line_white" contype="0" conaffinity="0"/>
      <geom type="box" pos=" 14.1  3.0 0.01" size="0.9 0.04 0.002" material="line_white" contype="0" conaffinity="0"/>
      <geom type="box" pos=" 14.1 -3.0 0.01" size="0.9 0.04 0.002" material="line_white" contype="0" conaffinity="0"/>
      <geom type="box" pos=" 13.2  0.0 0.01" size="0.04 3.0 0.002" material="line_white" contype="0" conaffinity="0"/>
    </body>
    <!-- ================= END FIELD LINES ================= -->

    <!-- Goals (unchanged) -->
    <body name="goal_left" pos="-4.5 0 0">
      <geom name="left_post_left"  type="cylinder" pos="0 -1.0 0.6" size="0.05 0.6" rgba="1 1 1 1" mass="0" condim="3" contype="1" conaffinity="1"/>
      <geom name="left_post_right" type="cylinder" pos="0  1.0 0.6" size="0.05 0.6" rgba="1 1 1 1" mass="0" condim="3" contype="1" conaffinity="1"/>
      <geom name="left_crossbar"   type="cylinder" fromto="0 -1.0 1.2 0 1.0 1.2" size="0.05" rgba="1 1 1 1" mass="0" condim="3" contype="1" conaffinity="1"/>
    </body>
    <body name="goal_right" pos="4.5 0 0">
      <geom name="right_post_left"  type="cylinder" pos="0 -1.0 0.6" size="0.05 0.6" rgba="1 1 1 1" mass="0" condim="3" contype="1" conaffinity="1"/>
      <geom name="right_post_right" type="cylinder" pos="0  1.0 0.6" size="0.05 0.6" rgba="1 1 1 1" mass="0" condim="3" contype="1" conaffinity="1"/>
      <geom name="right_crossbar"   type="cylinder" fromto="0 -1.0 1.2 0 1.0 1.2" size="0.05" rgba="1 1 1 1" mass="0" condim="3" contype="1" conaffinity="1"/>
    </body>

    <!-- Ball -->
    <body name="ball" pos="0 0 0.2">
      <freejoint/>
      <geom type="sphere" size="0.11" mass="0.43" material="ball_mat" friction="1.2 0.005 0.002"/>
<!-- camera glued to the ball -->
  <camera name="ball_cam" mode="track" fovy="60" euler="90 90 0"/>
    </body>

  <!-- Example robot (fixed in the world; no joint) -->
  <!-- Example robot (fixed) -->
  <body name="robot" pos="5 0 0.1">
    <geom type="box" size="0.25 0.18 0.08" mass="2.0" rgba="0.2 0.2 0.8 1"/>
    <!-- light that follows the robot -->
    <light name="robot_light" pos="5 0 8" directional="false" diffuse="0.8 0.8 0.8"/>

    <!-- Camera mounted a bit in front & above, looking toward -X (field center) -->
<!--    <body name="robot_cam_mount" pos="0.40 0 0.15">   &lt;!&ndash; z = 0.20 > 0.18 &ndash;&gt;-->
<!--      <camera name="ball_cam" mode="fixed" fovy="60" euler="90 90 0"/>-->
<!--    </body>-->
  </body>


  </worldbody>

  <actuator/>
</mujoco>
